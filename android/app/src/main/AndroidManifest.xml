<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only network-state check (isOnline() in MainActivity, shown as
         the Arabic "no internet" screen instead of the WebView's own
         English error page) — without this the app crashed on every launch
         with a SecurityException from ConnectivityManager.getActiveNetwork(). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Speaking-section questions record audio via the page's own
         getUserMedia() call (see buildSpeakingWidget in app.js) — WebView
         only ever grants that if this permission exists AND the user taps
         Allow when Android's own runtime prompt shows (handled in
         MainActivity via ActivityCompat.requestPermissions before it ever
         reaches WebChromeClient.onPermissionRequest). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The CV/profile-photo and admin material-upload file pickers
         (<input type="file">) can offer "take a photo" as one of their
         chooser options — needs this even though the WebView itself never
         touches the camera directly. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Interview"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the WebView-hosted file picker write directly into a
             FileProvider-shared temp file when "take a photo" is chosen
             from the chooser — without this, camera capture inside a
             WebView file input silently fails on modern Android (scoped
             storage blocks a raw file:// Uri handed to the camera app). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.sonbola.interview.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
