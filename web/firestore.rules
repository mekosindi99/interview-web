rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isStaff() { return isSignedIn() && (role() == 'admin' || role() == 'coadmin'); }

    match /meta/adminBootstrap {
      allow read: if true;
      // Locks itself after the very first admin account is created.
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/meta/adminBootstrap);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      // Candidates may only update their own exam-progress fields, never role/blocked/deleted/score.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.blocked == resource.data.blocked
        && request.resource.data.deleted == resource.data.deleted
        && !("score" in request.resource.data.diff(resource.data).affectedKeys());
      allow update, delete: if isAdmin();
      allow update: if isSignedIn() && role() == 'coadmin' && resource.data.role == 'candidate';
      allow create: if isStaff(); // admin/coadmin create candidate & coadmin accounts (via secondary auth app)
      // One-time bootstrap: a brand-new signed-in user may create their OWN
      // profile as 'admin' only while meta/adminBootstrap doesn't exist yet.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/meta/adminBootstrap);
    }

    match /questions/{qid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attempts/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      // Candidates submit their own attempt (auto-graded reading/listening
      // fields included) but can never set manual-grading fields or mark
      // themselves "graded" — that's staff-only, done from the admin grading
      // panel (see renderCandidateResultPanel in app.js).
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.examStatus != 'graded'
        && !('manualScores' in request.resource.data)
        && !('gradedBy' in request.resource.data)
        && !('gradedAt' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid
        && resource.data.examStatus != 'graded'
        && request.resource.data.examStatus != 'graded'
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['manualScores', 'manualScore', 'gradedBy', 'gradedAt']);
      allow update: if isStaff();
      // Admin-only, and only to reset a candidate for a retake — the
      // attempt is archived into pastAttempts (below) by the client before
      // this ever runs, so nothing is actually lost, just moved.
      allow delete: if isAdmin();
    }

    // One archived attempt per past exam a candidate has taken — written
    // by the admin client when resetting a candidate for a retake (copies
    // the live attempts/{uid} doc here first), so old results survive as
    // history instead of being overwritten by the next attempt.
    match /users/{uid}/pastAttempts/{attemptId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create, delete: if isAdmin();
    }

    // Single shared docs: settings/examConfig (section timers) and
    // settings/material (training file metadata) — admin-editable, staff+
    // candidates can read.
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // One doc per candidate reading session of the training material —
    // logs open time, per-page dwell time, close time. Candidates can only
    // read/write their OWN sessions; staff read all for the stats view.
    match /materialSessions/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      // Staff-only bulk cleanup (the admin's "تصفير إحصائيات القراءة"
      // button) — there was no delete rule at all before, so that button
      // failed with permission-denied on every click.
      allow delete: if isStaff();
    }

    // Best-effort device block list: checked right after sign-in so a
    // blocked candidate can't just re-register a fresh account on the same
    // browser. Deliberately device-only, not IP-based — an IP is shared by
    // a whole household/office network, so blocking one would risk locking
    // out everyone else on that network too. Not a hard security boundary
    // (client-reported device id).
    match /blockedDevices/{id} {
      // Split get/list: the client only ever needs to look up its OWN
      // device id by name (a single get, done right after sign-in) — it
      // never needs to enumerate the whole collection. Restricting list to
      // staff stops a signed-in candidate from listing every blocked
      // device id via an unfiltered collection query.
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow write: if isStaff();
    }

    // Login-device fingerprints (IP/User-Agent/device type/browser), one
    // doc per device a candidate has signed in from. Always written by the
    // admin server (server/index.js's /log-login) via the Admin SDK, which
    // bypasses these rules entirely — this only governs who can READ them.
    match /users/{uid}/loginDevices/{deviceId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // Public results board — every signed-in candidate can see every other
    // candidate's name + score, for the "everyone can verify the results"
    // request this was built for. Client-write is deliberately disabled:
    // this is only ever written by the admin server's /leaderboard/sync/:uid
    // (server/index.js) via the Admin SDK right after grading, reading the
    // real score from attempts/{uid} itself — a candidate can't write
    // themselves a fake entry here even indirectly.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
