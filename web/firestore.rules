rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isStaff() { return isSignedIn() && (role() == 'admin' || role() == 'coadmin'); }

    match /meta/adminBootstrap {
      allow read: if true;
      // Locks itself after the very first admin account is created.
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/meta/adminBootstrap);
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      // Candidates may only update their own exam-progress fields, never role/blocked/deleted/score.
      // examSectionDeadline is client-writable (advancing sections locally
      // needs it) but capped to at most 8h ahead of Firestore's own request
      // time — without this a candidate could set it to any arbitrary future
      // timestamp from the console and get unlimited section time. Not a
      // full server-authoritative timer (a candidate can still repeatedly
      // renew it up to the cap before it expires), but it closes the
      // "set it to year 3000 once" version of the bug. 8h is deliberately
      // generous — the admin's section-length field (renderExamConfigForm in
      // app.js) has no enforced upper bound, so the cap only needs to sit
      // safely above any realistic configured section length, not match it
      // exactly.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.blocked == resource.data.blocked
        && request.resource.data.deleted == resource.data.deleted
        && !("score" in request.resource.data.diff(resource.data).affectedKeys())
        && (!("examSectionDeadline" in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.examSectionDeadline <= request.time.toMillis() + 28800000);
      allow update, delete: if isAdmin();
      // Unlike every other update rule here, this one carried NO constraint
      // on the new data — only on the target doc's role beforehand. A
      // coadmin (who can already create candidates, and therefore knows
      // their own throwaway candidate's uid) could updateDoc({role:'admin'})
      // straight from the client and self-promote to full admin, since
      // Firestore rules are OR'd and this branch alone was enough to permit
      // it. Now mirrors the candidate self-update rule just above: role
      // can't change and score (which lives only on attempts/{uid} per the
      // comment there) can't be touched, while blocked/deleted/exam-progress
      // fields stay writable since a coadmin legitimately sets those
      // (block/unblock, soft delete, exam reset) via direct client writes.
      allow update: if isSignedIn() && role() == 'coadmin' && resource.data.role == 'candidate'
        && request.resource.data.role == resource.data.role
        && !("score" in request.resource.data.diff(resource.data).affectedKeys());
      allow create: if isStaff(); // admin/coadmin create candidate & coadmin accounts (via secondary auth app)
      // One-time bootstrap: a brand-new signed-in user may create their OWN
      // profile as 'admin' only while meta/adminBootstrap doesn't exist yet.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && !exists(/databases/$(database)/documents/meta/adminBootstrap);
    }

    match /questions/{qid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // The actual answer key (correctAnswer/correctIndex), split out of
    // questions/{qid} into its own doc so a candidate — who must be able to
    // read questions/{qid} to take the exam at all — can never read the
    // correct answer for a question before (or during) their own attempt.
    // Staff can read it (question-bank editing, admin grading views);
    // grading itself is done by the admin server via the Admin SDK, which
    // bypasses this rule entirely.
    match /questionAnswers/{qid} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /attempts/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      // Candidates submit their own attempt (raw answers only) but can never
      // set manual-grading fields, mark themselves "graded", or write their
      // own score — auto-grading now happens server-side (see
      // POST /exam/grade/:uid in server/index.js, which reads the real
      // answer key from questionAnswers/{qid} — a collection candidates
      // cannot read — and writes autoScore/sectionScores/perQuestionCorrect/
      // needsManualGrading via the Admin SDK, bypassing these rules
      // entirely). Without this block a candidate could otherwise call
      // setDoc/updateDoc on their own attempt straight from the console and
      // hand themselves an arbitrary score.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.examStatus != 'graded'
        && !('manualScores' in request.resource.data)
        && !('gradedBy' in request.resource.data)
        && !('gradedAt' in request.resource.data)
        && !('autoScore' in request.resource.data)
        && !('score' in request.resource.data)
        && !('sectionScores' in request.resource.data)
        && !('perQuestionCorrect' in request.resource.data)
        && !('needsManualGrading' in request.resource.data)
        && !('totalPoints' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid
        && resource.data.examStatus != 'graded'
        && request.resource.data.examStatus != 'graded'
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['manualScores', 'manualScore', 'gradedBy', 'gradedAt',
                       'autoScore', 'score', 'sectionScores', 'perQuestionCorrect',
                       'needsManualGrading', 'totalPoints']);
      allow update: if isStaff();
      // Admin-only, and only to reset a candidate for a retake — the
      // attempt is archived into pastAttempts (below) by the client before
      // this ever runs, so nothing is actually lost, just moved.
      allow delete: if isAdmin();
    }

    // One archived attempt per past exam a candidate has taken — written
    // by the admin client when resetting a candidate for a retake (copies
    // the live attempts/{uid} doc here first), so old results survive as
    // history instead of being overwritten by the next attempt.
    match /users/{uid}/pastAttempts/{attemptId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create, delete: if isAdmin();
    }

    // Single shared docs: settings/examConfig (section timers) and
    // settings/material (training file metadata) — admin-editable, staff+
    // candidates can read.
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // One doc per candidate reading session of the training material —
    // logs open time, per-page dwell time, close time. Candidates can only
    // read/write their OWN sessions; staff read all for the stats view.
    match /materialSessions/{id} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      // Staff-only bulk cleanup (the admin's "تصفير إحصائيات القراءة"
      // button) — there was no delete rule at all before, so that button
      // failed with permission-denied on every click.
      allow delete: if isStaff();
    }

    // Best-effort device block list: checked right after sign-in so a
    // blocked candidate can't just re-register a fresh account on the same
    // browser. Deliberately device-only, not IP-based — an IP is shared by
    // a whole household/office network, so blocking one would risk locking
    // out everyone else on that network too. Not a hard security boundary
    // (client-reported device id).
    match /blockedDevices/{id} {
      // Split get/list: the client only ever needs to look up its OWN
      // device id by name (a single get, done right after sign-in) — it
      // never needs to enumerate the whole collection. Restricting list to
      // staff stops a signed-in candidate from listing every blocked
      // device id via an unfiltered collection query.
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow write: if isStaff();
    }

    // Login-device fingerprints (IP/User-Agent/device type/browser), one
    // doc per device a candidate has signed in from. Always written by the
    // admin server (server/index.js's /log-login) via the Admin SDK, which
    // bypasses these rules entirely — this only governs who can READ them.
    match /users/{uid}/loginDevices/{deviceId} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
    }

    // Public results board — every signed-in candidate can see every other
    // candidate's name + score, for the "everyone can verify the results"
    // request this was built for. Client-write is deliberately disabled:
    // this is only ever written by the admin server's /leaderboard/sync/:uid
    // (server/index.js) via the Admin SDK right after grading, reading the
    // real score from attempts/{uid} itself — a candidate can't write
    // themselves a fake entry here even indirectly.
    match /leaderboard/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
